# https://aistudio.google.com/apikey 에서 무료 발급 (Google 계정만 있으면 됨, 카드 불필요)
GEMINI_API_KEY=AIza...

# 위 키를 쓰려면 이 값을 1로 명시해야 한다 (로컬에서 혼자 쓸 때 편의용).
# 설정하지 않으면 접속자가 각자 사이드바에 자기 키를 입력해야 한다.
# 배포 환경(Streamlit Cloud Secrets)에는 절대 넣지 말 것 — 넣으면 접속자 전원이
# 내 무료 한도를 소모한다.
ALLOW_SERVER_API_KEY=1

# 선택: 사용할 Gemini 모델 (기본값 gemini-flash-latest = 최신 Flash 자동 사용)
# GEMINI_MODEL=gemini-flash-latest
